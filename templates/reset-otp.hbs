<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Reset Your Password — DB Visualizer</title>
  <style>
    /* ── Reset ── */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    /* ── Base ── */
    body {
      background-color: #09090b;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Outer wrapper ── */
    .wrapper {
      width: 100%;
      padding: 48px 16px;
      background-color: #09090b;
    }

    /* ── Card ── */
    .card {
      max-width: 480px;
      margin: 0 auto;
      background-color: #18181b;
      border: 1px solid #27272a;
      border-radius: 16px;
      overflow: hidden;
    }

    /* ── Header ── */
    .header {
      padding: 22px 32px;
      border-bottom: 1px solid #27272a;
    }
    .header-inner {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .logo-icon {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      background-color: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.25);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .logo-text {
      font-size: 16px;
      font-weight: 700;
      color: #fafafa;
      letter-spacing: -0.3px;
    }

    /* ── Body ── */
    .body {
      padding: 40px 32px;
    }
    .heading {
      font-size: 22px;
      font-weight: 700;
      color: #fafafa;
      letter-spacing: -0.5px;
      line-height: 1.2;
      margin-bottom: 8px;
    }
    .subtext {
      font-size: 14px;
      color: #71717a;
      line-height: 1.65;
      margin-bottom: 32px;
    }
    .subtext strong { color: #a1a1aa; }

    /* ── OTP section ── */
    .otp-label {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #52525b;
      margin-bottom: 10px;
    }
    .otp-box {
      background-color: #09090b;
      border: 1px solid #27272a;
      border-radius: 12px;
      text-align: center;
      padding: 28px 20px;
      margin-bottom: 22px;
    }
    .otp-code {
      font-size: 46px;
      font-weight: 800;
      letter-spacing: 0.35em;
      color: #3b82f6;
      font-family: 'Courier New', Courier, monospace;
      line-height: 1;
      display: block;
    }

    /* ── Expiry pill ── */
    .expiry-wrap {
      text-align: center;
      margin-bottom: 32px;
    }
    .expiry-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background-color: rgba(234, 179, 8, 0.08);
      border: 1px solid rgba(234, 179, 8, 0.22);
      border-radius: 999px;
      padding: 6px 16px;
      font-size: 12px;
      font-weight: 500;
      color: #ca8a04;
      white-space: nowrap;
    }

    /* ── Divider ── */
    .divider {
      height: 1px;
      background-color: #27272a;
      margin-bottom: 24px;
    }

    /* ── Warning box ── */
    .warning {
      background-color: rgba(239, 68, 68, 0.05);
      border: 1px solid rgba(239, 68, 68, 0.15);
      border-radius: 10px;
      padding: 14px 16px;
      margin-bottom: 24px;
      font-size: 13px;
      color: #f87171;
      line-height: 1.6;
    }

    /* ── Audit trail ── */
    .audit {
      font-size: 12px;
      color: #52525b;
      line-height: 1.7;
    }
    .audit strong { color: #71717a; }

    /* ── Footer ── */
    .footer {
      padding: 20px 32px;
      border-top: 1px solid #27272a;
      text-align: center;
      font-size: 12px;
      color: #3f3f46;
      line-height: 1.7;
    }

    /* ── Responsive ── */
    @media (max-width: 520px) {
      .header  { padding: 18px 20px; }
      .body    { padding: 28px 20px; }
      .footer  { padding: 16px 20px; }
      .heading  { font-size: 19px; }
      .otp-code { font-size: 36px; letter-spacing: 0.25em; }
    }
  </style>
</head>

<body>
  <div class="wrapper">
    <div class="card">

      <!-- ── HEADER ── -->
      <div class="header">
        <div class="header-inner">
          <div class="logo-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="#3b82f6" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="12" cy="5" rx="9" ry="3" />
              <path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5" />
              <path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3" />
            </svg>
          </div>
          <span class="logo-text">DB Visualizer</span>
        </div>
      </div>

      <!-- ── BODY ── -->
      <div class="body">

        <p class="heading">Reset your password</p>

        <p class="subtext">
          Hi <strong>{{name}}</strong>, use the one-time code below to reset your
          DB Visualizer password. Do&nbsp;not share this code with anyone.
        </p>

        <p class="otp-label">Your verification code</p>

        <div class="otp-box">
          <span class="otp-code">{{otp}}</span>
        </div>

        <div class="expiry-wrap">
          <span class="expiry-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                 stroke="#ca8a04" stroke-width="2.5" stroke-linecap="round"
                 stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            Expires in {{expiresInMinutes}} minutes
          </span>
        </div>

        <div class="divider"></div>

        <div class="warning">
          If you did not request a password reset, you can safely ignore this email.
          Your password will not change unless you enter this code.
        </div>

        <p class="audit">
          Requested from IP&nbsp;<strong>{{ip}}</strong>&nbsp;at&nbsp;<strong>{{timestamp}}</strong>.
        </p>

      </div>

      <!-- ── FOOTER ── -->
      <div class="footer">
        &copy; {{year}} DB Visualizer. All rights reserved.<br />
        This is an automated security email &mdash; please do not reply.
      </div>

    </div>
  </div>
</body>

</html>